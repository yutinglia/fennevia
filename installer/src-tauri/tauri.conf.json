{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fennevia Setup",
  "version": "0.20.0-beta.1",
  "identifier": "org.fennevia.setup",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Fennevia Setup",
        "width": 1000,
        "height": 740,
        "minWidth": 620,
        "minHeight": 500,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["installer"]
    }
  },
  "bundle": { "active": false }
}
