{
  "name": "fennevia-installer",
  "version": "0.19.0-beta.1",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "build": "node scripts/generate-icon.mjs && vite build",
    "build:native": "npm run build && node scripts/build-native.mjs",
    "package:native": "npm run build && node scripts/prepare-distribution.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "node ../node_modules/eslint/bin/eslint.js ui scripts/*.mjs tests/*.mjs *.js *.ts",
    "smoke:native": "node scripts/smoke-native.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm audit --audit-level=moderate && npm run build",
    "format:check": "prettier --check ui scripts/*.mjs tests/*.mjs *.json *.js *.ts src-tauri/*.json src-tauri/capabilities/*.json",
    "format": "prettier --write ui scripts/*.mjs tests/*.mjs *.json *.js *.ts src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1"
  }
}
