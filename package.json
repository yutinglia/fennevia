{
  "name": "fennevia",
  "version": "0.15.0-beta.1",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "artifacts": "pwsh -NoProfile -File ./scripts/check-production-artifacts.ps1 -ArtifactRoot ./profile/chrome/fennevia -InventoryPath ./package-manifest.json",
    "build": "node ./scripts/build-frontend.mjs && node ./scripts/build-firefox-bridge.mjs && node ./scripts/sync-package-manifest.mjs",
    "build:bridge": "node ./scripts/build-firefox-bridge.mjs",
    "build:frontend": "node ./scripts/build-frontend.mjs",
    "env": "pwsh -NoProfile -File ./scripts/fennevia.ps1",
    "dependencies:audit": "node ./scripts/audit-frontend-dependencies.mjs",
    "format": "prettier --write ./src \"./tests/*.test.mjs\" ./tests/session-restore-contract.mjs ./tests/support \"./profile/chrome/fennevia/content/*.mjs\" \"./profile/chrome/fennevia/content/runtime/*.mjs\" ./scripts/*.mjs ./vite.config.ts ./vite.firefox.config.ts ./svelte.config.js ./eslint.config.js ./tsconfig.json ./tsconfig.node.json ./package.json ./release/release-config.json ./.github/workflows/ci.yml ./.github/workflows/release.yml",
    "format:check": "prettier --check ./src \"./tests/*.test.mjs\" ./tests/session-restore-contract.mjs ./tests/support \"./profile/chrome/fennevia/content/*.mjs\" \"./profile/chrome/fennevia/content/runtime/*.mjs\" ./scripts/*.mjs ./vite.config.ts ./vite.firefox.config.ts ./svelte.config.js ./eslint.config.js ./tsconfig.json ./tsconfig.node.json ./package.json ./release/release-config.json ./.github/workflows/ci.yml ./.github/workflows/release.yml",
    "lint": "eslint ./src \"./tests/*.mjs\" ./tests/support \"./profile/chrome/fennevia/content/*.mjs\" \"./profile/chrome/fennevia/content/runtime/*.mjs\" ./scripts/*.mjs ./vite.config.ts ./vite.firefox.config.ts ./svelte.config.js",
    "release:build": "pwsh -NoProfile -File ./scripts/build-release.ps1 -OutputDirectory ./.release",
    "test": "node --test \"./tests/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/app/** --test-coverage-include=src/firefox/** --test-coverage-exclude=**/*.d.ts --test-coverage-lines=80 --test-coverage-functions=80 ./tests/*.test.mjs",
    "test:powershell": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tests/run-static-powershell-tests.ps1",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --project ./tsconfig.node.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:powershell && npm run dependencies:audit && npm run build && npm run artifacts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
}
