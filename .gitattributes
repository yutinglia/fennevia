# Installed artifact bytes must remain stable across operating systems because
# package-manifest.json records their SHA-256 digests.
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.mjs text eol=lf
*.svelte text eol=lf
*.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
program/defaults/pref/*.js text eol=crlf
program/*.cfg text eol=crlf
profile/chrome/fennevia/chrome.manifest text eol=crlf
profile/chrome/fennevia/**/*.css text eol=lf
profile/chrome/fennevia/**/*.js text eol=lf
profile/chrome/fennevia/**/*.mjs text eol=lf
profile/chrome/fennevia/**/*.txt text eol=lf
# Native byte pins, lock hashes and notices must survive checkout/archive unchanged.
installer/** text=auto eol=lf
# Preserve whitespace in upstream source and license texts verbatim.
installer/vendor/** -whitespace
installer/licenses/** -whitespace
